{
    "name": "chillychills-admin-desktop",
    "version": "1.0.0",
    "description": "Premium Desktop Admin Panel for ChillyChills",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder"
    },
    "author": "ChillyChills",
    "license": "MIT",
    "dependencies": {
        "electron-is-dev": "^2.0.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.0.0"
    },
    "build": {
        "appId": "com.chillychills.admin",
        "productName": "ChillyAdmin Pro",
        "win": {
            "target": "portable"
        },
        "directories": {
            "output": "dist"
        },
        "extraResources": [
            "admin-panel-copy/**",
            "assets-copy/*",
            "config.json"
        ]
    }
}